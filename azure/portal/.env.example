# mock  = sélecteur de rôle, sans Entra ID (développement local)
# entra = vraie connexion MSAL
VITE_AUTH_MODE=mock
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_SCOPE=api://<client-id-api>/access_as_user
# vide = même origine (/api via proxy) ; sinon URL de l'API (plan Free + CORS)
VITE_API_BASE=
